{
  "name": "celina-sousa-turismo",
  "version": "1.0.0",
  "description": "Plataforma completa de turismo, clubes, locações e viagens para Celina Sousa Turismo (Caldas Locações)",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:server": "node --no-warnings server/index.js",
    "dev:client": "VITE_APP_MODE=customer vite --host 0.0.0.0 --port 5173",
    "dev:admin": "VITE_APP_MODE=admin vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "build:customer": "VITE_APP_MODE=customer vite build --outDir dist/customer",
    "build:admin": "VITE_APP_MODE=admin vite build --outDir dist/admin",
    "start": "NODE_ENV=production node --no-warnings server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
